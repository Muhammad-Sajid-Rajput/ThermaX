# ThermaX Python ML Microservice Environment Template (.env.example)
PORT=8000
MONGO_URI=mongodb://localhost:27017/thermax
MONGODB_URI=mongodb://localhost:27017/thermax

# DBSCAN Spatial Clustering Hyperparameters
DBSCAN_EPS_KM=1.5
DBSCAN_MIN_SAMPLES=3

# Google Earth Engine Credentials / Project ID
GEE_PROJECT_ID=heatmappingfyp

# Task Worker Redis Broker
REDIS_URL=redis://localhost:6379/0
