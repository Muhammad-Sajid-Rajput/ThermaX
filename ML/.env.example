# ThermaX Python ML Microservice Environment Template (.env.example)
PORT=8000
MONGO_URI=mongodb://localhost:27017/thermax
MONGODB_URI=mongodb://localhost:27017/thermax

# DBSCAN Spatial Clustering Hyperparameters
# (Phase 8 calibration: eps=1.0 recovers the seeded hotspot geometry;
# see README.md)
DBSCAN_EPS_KM=1.0
DBSCAN_MIN_SAMPLES=3

# Google Earth Engine Credentials / Project ID
GEE_PROJECT_ID=heatmappingfyp

# Phase 4: scheduled pipeline + service auth + guards
PIPELINE_INTERVAL_MINUTES=30
# Shared secret the ML service requires as X-Service-Key on /enrich,
# /cluster and /fuse. Must match the backend's ML_SERVICE_KEY. Empty in
# local dev (endpoints stay open with a startup warning).
ML_SERVICE_KEY=
ML_RATE_LIMIT_PER_MINUTE=100
ML_MAX_BODY_BYTES=5242880
ENV=development
INCLUDE_SYNTHETIC_REPORTS=false

# Task Worker Redis Broker
REDIS_URL=redis://localhost:6379/0

# Quality Control (QC) Calibration Tolerances
QC_TEMP_TOLERANCE_C=3.0
QC_ANOMALY_TOLERANCE_C=8.0
QC_SCORE_PENALTY_PER_FAILURE=0.35

# Thermal Vulnerability Index (TVI-lite) Component Weights (sum = 1.0)
TVI_HEAT_WEIGHT=0.5
TVI_REPORT_WEIGHT=0.3
TVI_POP_WEIGHT=0.2

# TVI Normalization Caps
TVI_HEAT_MAX=100.0
TVI_REPORT_DENSITY_CAP=20.0
TVI_POP_DENSITY_CAP=50000.0

# TVI Risk Tier Operational Cutoffs (0.0 - 1.0)
TVI_TIER_CRITICAL=0.65
TVI_TIER_HIGH=0.45
TVI_TIER_MODERATE=0.25

# Advisory Band Thresholds
HEAT_INDEX_EXTREME=45.0
HEAT_INDEX_HIGH=38.0
POP_DENSITY_HIGH=15000.0
PEAK_TEMP_EXTREME=45.0

# Optional custom paths (defaults point to Backend/data/)
# CITIES_CONFIG_PATH=../Backend/data/cities.json
# POP_GRID_DIR=../Backend/data/pop_grids
