# ThermaX Project - Root .gitignore
# ===================================

# Environment Variables
# ---------------------
.env
.env.*.local
.env.local
!.env.example

# Dependencies
# ------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Package manager files
# ---------------------
.yarn-integrity
.npm
# Keep package-lock.json for npm, uncomment below if using yarn exclusively
# yarn.lock

# Build Outputs
# -------------
dist/
build/
out/
.next/
.nuxt/
.vuepress/dist/
.parcel-cache
.cache/

# Vite/Rollup
*.local

# Runtime Data
# ------------
pids
*.pid
*.seed
*.pid.lock

# Testing & Coverage
# ------------------
coverage/
*.lcov
.nyc_output
test-results/
playwright-report/
test-results.xml
*.prof

# TypeScript
# ----------
*.tsbuildinfo

# ESLint & Stylelint
# ------------------
.eslintcache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
# Python
__pycache__/
*.pyc
*.pyo

# Logs
# ----
logs/
*.log

# Database files
# ---------------
*.db
*.sqlite
*.sqlite3

# Editor & IDE
# ------------
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
# -------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Backup files
# ------------
*.bak
*.backup
*.tmp
*.temp
tmp/
temp/

# Local configuration
# --------------------
config.local.js
config.local.json
.local
.localstorage
user-config/
personal-settings/

# API Keys and Secrets
# ---------------------
secrets/
credentials/
api-keys/
*.key
*.pem
*.p12
*.pfx

# Documentation build
# -------------------
docs/build/

# Infrastructure
# --------------
# Terraform
*.tfstate
*.tfstate.*
.terraform/

# Docker
.dockerignore
docker-compose.override.yml

# Kubernetes
*.kubeconfig

# Sentry
.sentryclirc
