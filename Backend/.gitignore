node_modules/
jspm_packages/
bower_components/

# Build Outputs
# -------------
dist/
build/
out/

# Environment Variables
# ---------------------
.env
.env.*.local
.env.local
!.env.example

# Logs
# ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Backend specific logs
access.log
error.log
combined.log
morgan.log

# Runtime data
# ------------
pids
*.pid
*.seed
*.pid.lock

# Testing & Coverage
# ------------------
coverage/
*.lcov
.nyc_output
test-results/

# TypeScript
# ----------
*.tsbuildinfo

# ESLint
# ------
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Package manager files
# ---------------------
.yarn-integrity
.npm
*.tgz

# Editor & IDE
# ------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
# -------------------
.DS_Store
Thumbs.db

# Temporary folders
# -----------------
tmp/
temp/
.tmp/

