PORT=5001
NODE_ENV=development

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

MONGODB_URI=mongodb://localhost:27017/thermax
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174,http://[::1]:5174

# WeatherAPI.com — https://www.weatherapi.com/my/
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_CACHE_TTL_MS=900000
WEATHER_SAVE_COOLDOWN_MS=900000
WEATHER_HEAT_ALERT_C=45

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
