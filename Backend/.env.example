# ThermaX Backend Environment Template (.env.example)
PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb://localhost:27017/thermax
MONGODB_URI=mongodb://localhost:27017/thermax

# Authentication & JWT Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS Allowed Frontend Origins
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# WeatherAPI.com Configuration — https://www.weatherapi.com/my/
WEATHER_API_KEY=your_weatherapi_key_here
WEATHER_CACHE_TTL_MS=900000
WEATHER_SAVE_COOLDOWN_MS=900000
WEATHER_HEAT_ALERT_C=45

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ML Microservice Endpoint
ML_SERVICE_URL=http://localhost:8000
