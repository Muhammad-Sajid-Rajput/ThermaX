# ThermaX Frontend - React/Vite .gitignore
# ===========================================

# Dependencies
# ------------
node_modules/
jspm_packages/
bower_components/

# Build Outputs
# -------------
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.vuepress/dist/

# Vite / Rollup specific
# -----------------------
*.local
.vite/

# Environment Variables
# ---------------------
.env
.env.*.local
.env.local
!.env.example

# Logs
# ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
# ------------
pids
*.pid
*.seed
*.pid.lock

# Testing & Coverage
# ------------------
coverage/
*.lcov
.nyc_output
test-results/
playwright-report/
test-results.xml

# ESLint & Stylelint
# ------------------
.eslintcache
.stylelintcache

# TypeScript
# ----------
*.tsbuildinfo

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Package manager files
# ---------------------
.yarn-integrity
.npm

# Output of 'npm pack'
*.tgz

# Editor & IDE
# ------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
# -------------------
.DS_Store
Thumbs.db

# Temporary folders
# -----------------
tmp/
temp/
*.tmp
*.temp

# CSS and Sass
# ------------
.sass-cache/

# Local development
# -----------------
.local
.localstorage

# API Keys and Secrets
# --------------------
config.local.js
config.local.json
secrets/
credentials/

# Browser cache
.browser-sync
.hmr-cache

# Source maps (production)
*.map

# Bundle analyzer
# ----------------
bundle-analyzer-report.html
stats.html

# PWA generated files
# --------------------
sw.js
workbox-*.js

# Sentry
.sentryclirc

# Lighthouse reports
lighthouse-reports/
