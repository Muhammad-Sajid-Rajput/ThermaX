// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AdvisoryBanner > matches the rendered snapshot for a critical advisory 1`] = `"<div role="alert" dir="ltr" class="rounded-xl border p-4 shadow-sm border-red-300 bg-red-50"><div class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert w-5 h-5 mt-0.5 shrink-0 text-red-600" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg><div class="flex-1 min-w-0"><div class="flex items-center gap-2 mb-1 flex-wrap"><span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-red-600 text-white">Critical heat risk</span><span class="text-[11px] font-medium text-slate-600">Gulshan-e-Iqbal</span></div><p class="text-sm text-slate-800 leading-relaxed ">Extreme heat danger in your area. Stay indoors.</p><p class="text-[11px] text-slate-500 mt-1">Heat index: 46°C</p></div><div class="flex items-center gap-1 shrink-0"><button type="button" class="p-1.5 rounded-lg text-slate-500 hover:text-slate-800 hover:bg-white/60 transition-colors" title="اردو میں دیکھیں" aria-label="Switch to Urdu"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-languages w-4 h-4" aria-hidden="true"><path d="m5 8 6 6"></path><path d="m4 14 6-6 2-3"></path><path d="M2 5h12"></path><path d="M7 2h1"></path><path d="m22 22-5-10-5 10"></path><path d="M14 18h6"></path></svg></button><button type="button" class="p-1.5 rounded-lg text-slate-500 hover:text-slate-800 hover:bg-white/60 transition-colors" aria-label="Dismiss advisory"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x w-4 h-4" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div></div></div>"`;
